# ============================================================
# SERVER CONFIGURATION (.env)
# ============================================================

# Application Environment & Port
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://sparshchauhan:sparsh12@cluster0.00t8w7f.mongodb.net/pizza_delivery_db?retryWrites=true&w=majority

# JSON Web Token (JWT) Configuration (100 Years Expiration: 36500d)
JWT_SECRET=pizzanest_super_secret_jwt_key_level3_2026
JWT_EXPIRES_IN=36500d

# Razorpay Test Mode Credentials (Get from https://dashboard.razorpay.com/#/access/api-keys)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# Nodemailer / SMTP Configuration for Low-Stock Alerts & Password Resets
# (Leave blank to use automatic Ethereal test account with preview URLs logged)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM="PizzaNest Kitchen Alerts <no-reply@pizzanest.com>"
ADMIN_EMAIL=admin@pizzanest.com

# Low-Stock Check Cron Schedule (Standard 5-part cron syntax: minute hour day month day-of-week)
# Default is every 10 minutes: */10 * * * *
LOW_STOCK_CRON="*/10 * * * *"
