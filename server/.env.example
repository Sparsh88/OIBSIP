# ============================================================
# SERVER CONFIGURATION (.env)
# ============================================================

# Application Environment & Port
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/pizza_delivery_db

# JSON Web Token (JWT) Configuration
JWT_SECRET=pizzaro_super_secret_jwt_key_level3_2026
JWT_EXPIRES_IN=7d

# Razorpay Test Mode Credentials (Get from https://dashboard.razorpay.com/#/access/api-keys)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# Nodemailer / SMTP Configuration for Low-Stock Alerts & Password Resets
# (Leave blank to use automatic Ethereal test account with preview URLs logged)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM="Pizzaro Kitchen Alerts <no-reply@pizzaro.com>"
ADMIN_EMAIL=admin@pizzaro.com

# Low-Stock Check Cron Schedule
LOW_STOCK_CRON="*/10 * * * *"
